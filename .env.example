# IBOTVision SDK — Configuration Template
# Copy this file to .env and fill in your values.
# Never commit your .env file to version control.

# ── Publisher Key ─────────────────────────────────────────────────────────────
# Get your key at ibotvision.com or via POST /api/v1/publisher/register
IBOTVISION_API_KEY=vow_pub_your_key_here

# ── Gateway URL ───────────────────────────────────────────────────────────────
# Cloud (default — leave blank to use https://api.ibotvision.com):
IBOTVISION_GATEWAY_URL=https://api.ibotvision.com

# Enterprise self-hosted (replace with your own gateway address):
# IBOTVISION_GATEWAY_URL=https://your-own-gateway.internal

# ── Local Webhook ─────────────────────────────────────────────────────────────
# Only needed for examples/local_webhook.py
# VOW App must be running on this machine
VOW_APP_URL=http://localhost:7777
